{
  "name": "interview-os",
  "version": "1.0.0",
  "description": "InterviewOS - Hackathon AI-Powered Technical Interview Assistant",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "server": "tsx src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "test:api": "tsx src/testInterviewApi.ts",
    "build": "tsc && npm run build:frontend"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "groq-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
